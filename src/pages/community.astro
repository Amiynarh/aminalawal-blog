---
import BaseLayout from '@layouts/BaseLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { CONTACT, ORGS, RECOGNITION } from '@/data/site'

const g3Stats = [
    { value: 300, suffix: '+', label: 'IWD 2025 participants' },
    { value: 250, suffix: '+', label: 'WomenWhoAutomate applicants' },
    { value: 10, suffix: '', label: 'HerSite websites launched' },
    { value: 6, suffix: '', label: 'partner institutions, IWD 2025' },
]

const g3Programmes = [
    { name: 'WomenWhoAutomate', body: 'G3Women\'s first technical cohort, which drew 250+ applications.' },
    { name: 'HerSite', body: 'On IWD 2026, 10 live websites built for women-led businesses in a single day, from 97 applicants across Africa.', url: 'https://g3women.org/hersite' },
    { name: 'IWD Summit', body: '300+ participants and 6 partner institutions in 2025.' },
    { name: 'G3Digital Academy', body: 'A multilingual learning platform in English, Hausa, Yoruba and Igbo.', url: 'https://academy.g3women.org/' },
]
---

<BaseLayout
    title="Community"
    description="Amina Lawal founded G3Women and co-founded CNCF Kaduna, and is a Women Techmakers Ambassador. Communities, programmes and impact across northern Nigeria."
>
    <PageHeader
        path="/community"
        title="Communities that outlast the event."
        lede="I build communities and programmes that change who gets to work in tech, especially for women and for people outside Lagos. Here's what I've founded, led and grown."
    >
        <a href={CONTACT.g3women} target="_blank" rel="noopener noreferrer" class="btn-primary">Visit G3Women ↗</a>
        <a href="/mentorship" class="btn-ghost">Mentorship</a>
    </PageHeader>

    <!-- G3Women -->
    <section class="section pt-14">
        <div class="container-page">
            <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
                <div data-reveal>
                    <p class="eyebrow">Founder · Chairman · CTO · 2023 to now</p>
                    <h2 class="h-section">G3Women Network for Growth</h2>
                    <div class="mt-5 space-y-4 text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
                        <p>Northern Nigeria has talent but very little infrastructure for women entering digital tech. I founded G3Women in September 2023 to build that infrastructure. It was registered with the Corporate Affairs Commission in March 2025.</p>
                        <p>As Chairman I govern the board of trustees. As CTO I own every technical decision, from architecture to the platforms our learners use.</p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3" data-reveal style="--reveal-delay: 80ms">
                    {g3Stats.map(s => (
                        <div class="card p-5">
                            <p class="font-display text-4xl font-bold text-neutral-900 dark:text-neutral-50" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</p>
                            <p class="mt-2 text-sm font-medium text-neutral-800 dark:text-neutral-200">{s.label}</p>
                        </div>
                    ))}
                </div>
            </div>

            <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {g3Programmes.map((p, i) => {
                    const Tag = p.url ? 'a' : 'div'
                    return (
                        <Tag
                            {...(p.url ? { href: p.url, target: '_blank', rel: 'noopener noreferrer' } : {})}
                            class:list={['card p-6', p.url && 'card-hover group']}
                            data-reveal
                            style={`--reveal-delay: ${i * 60}ms`}
                        >
                            <h3 class="flex items-center justify-between font-bold text-neutral-900 dark:text-neutral-100">
                                {p.name}
                                {p.url && <span class="text-neutral-400 group-hover:text-sun-500">↗</span>}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{p.body}</p>
                        </Tag>
                    )
                })}
            </div>
        </div>
    </section>

    <!-- Other organisations -->
    <section class="section pt-0">
        <div class="container-page">
            <div data-reveal>
                <p class="eyebrow">$ git log --communities</p>
                <h2 class="h-section">Where else I've led</h2>
            </div>
            <ol class="mt-10 space-y-3">
                {ORGS.map((org, i) => (
                    <li data-reveal style={`--reveal-delay: ${i * 50}ms`}>
                        <details class="card group overflow-hidden" open={i === 0}>
                            <summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-6 gap-y-2 p-6 [&::-webkit-details-marker]:hidden">
                                <span class="w-32 font-mono text-xs text-neutral-500">{org.period}</span>
                                <span class="min-w-0 flex-1">
                                    <span class="block text-lg font-bold text-neutral-900 dark:text-neutral-100">{org.name}</span>
                                    <span class="block text-sm text-orange-500 dark:text-orange-300">{org.role}</span>
                                </span>
                                <span class="hidden gap-6 md:flex">
                                    {org.stats.map(s => (
                                        <span class="text-right">
                                            <span class="block font-display text-xl font-bold text-neutral-900 dark:text-neutral-100">{s.value}</span>
                                            <span class="block font-mono text-[10px] uppercase tracking-wider text-neutral-500">{s.label}</span>
                                        </span>
                                    ))}
                                </span>
                                <span class="flex size-8 items-center justify-center rounded-full border border-paper-300 font-mono transition group-open:rotate-45 group-open:border-sun-400 group-open:text-sun-500 dark:border-ink-600" aria-hidden="true">+</span>
                            </summary>
                            <div class="grid gap-6 border-t border-paper-200 p-6 dark:border-ink-700 md:grid-cols-[8rem_1fr] md:gap-x-6">
                                <span class="hidden md:block"></span>
                                <div>
                                    <p class="max-w-2xl leading-relaxed text-neutral-600 dark:text-neutral-400">{org.description}</p>
                                    <ul class="mt-4 space-y-2">
                                        {org.highlights.map(h => (
                                            <li class="flex gap-3 text-sm text-neutral-700 dark:text-neutral-300"><span class="text-sun-500">→</span>{h}</li>
                                        ))}
                                    </ul>
                                    {org.url && <a href={org.url} target="_blank" rel="noopener noreferrer" class="link-arrow mt-5 text-sm">Visit ↗</a>}
                                </div>
                            </div>
                        </details>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <!-- Recognition -->
    <section class="section pt-0">
        <div class="container-page">
            <p class="eyebrow" data-reveal>$ cat recognition.txt</p>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {RECOGNITION.map((r, i) => (
                    <div class="card p-6" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
                        <span class="text-2xl text-sun-500">✦</span>
                        <h3 class="mt-3 text-lg font-bold text-neutral-900 dark:text-neutral-100">{r.title}</h3>
                        <p class="mt-1 text-sm text-neutral-500">{r.by}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>
