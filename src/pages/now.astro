---
import BaseLayout from '@layouts/BaseLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { CONTACT, MENTORSHIP } from '@/data/site'

const updated = 'October 2026'

// Each "service" on the status page. `state` is just flavour: operational / building / learning.
const services = [
    {
        name: 'focus',
        state: 'operational',
        title: 'Platform engineering',
        items: [
            'Going deep on internal developer platforms and golden paths: giving teams self-service infrastructure that is safe by default, without hiding how it works.',
            'My working definition: platform engineering closes the gap between what teams want to build and what the infrastructure can sustain. The best platforms make the right thing the easy thing.',
        ],
    },
    {
        name: 'mentorship',
        state: 'building',
        title: MENTORSHIP.name,
        items: [
            'Running a 4-month, hands-on mentorship (two weeks per module) in Cloud, DevOps and Platform Engineering, from Linux and IAM to Kubernetes, IaC, CI/CD and observability. The waitlist for Cohort 2 is open.',
            'Proceeds go to G3Women, so every mentee is also funding programmes for women in tech.',
        ],
        link: { href: '/mentorship', label: 'How it works' },
    },
    {
        name: 'g3women',
        state: 'operational',
        title: 'G3Women',
        items: [
            'Serving as Chairman and CTO. Expanding the G3Digital Academy, our multilingual learning platform on Cloud Run, with more courses in English, Hausa, Yoruba and Igbo.',
            'HerSite IWD 2026 delivered 10 live websites for women-led businesses in a single day, from 97 applicants across Africa.',
        ],
        link: { href: CONTACT.g3women, label: 'g3women.org' },
    },
    {
        name: 'community',
        state: 'operational',
        title: 'CNCF Kaduna & GDE journey',
        items: [
            'Growing CNCF Kaduna, the cloud-native chapter I co-founded in 2025, the seventh in Nigeria.',
            'Working toward the full Google Developer Expert designation in Cloud, after the GDE Academy EMEA programme (1 of 57 from 1,452 applicants).',
        ],
    },
    {
        name: 'writing',
        state: 'building',
        title: 'Writing',
        items: [
            'Publishing practical tutorials for FreeCodeCamp and Google Cloud\'s Medium publication on networking, reliability and running containers well on GCP.',
        ],
        link: { href: '/writing', label: 'Latest articles' },
    },
    {
        name: 'learning',
        state: 'learning',
        title: 'Learning',
        items: [
            'Platform design patterns: golden paths, developer portals, and measuring whether a platform actually helps the people using it.',
            'Sharpening Kubernetes and observability fundamentals so I can teach them better than I learned them.',
        ],
    },
    {
        name: 'thinking',
        state: 'learning',
        title: 'Thinking about',
        items: [
            'Building for low-resource environments, where connectivity is unreliable, compute is expensive, and the assumption that users speak English is quietly baked into every default.',
            'The infrastructure gap in the Nigerian Startup Act. I raised it at the GIZ/DTC policy dialogue in 2023, and affordable cloud infrastructure outside Lagos still matters enormously.',
        ],
    },
]

const stateStyle: Record<string, { label: string, dot: string, text: string }> = {
    operational: { label: 'Operational', dot: 'bg-green-500', text: 'text-green-700 dark:text-green-400' },
    building: { label: 'Shipping', dot: 'bg-orange-400', text: 'text-orange-500 dark:text-orange-300' },
    learning: { label: 'In progress', dot: 'bg-yellow-400', text: 'text-yellow-500 dark:text-yellow-400' },
}
---

<BaseLayout
    title="Now"
    description="What Amina Lawal is working on, learning and thinking about right now."
>
    <PageHeader
        path="/now"
        title="What I'm up to now."
        lede="A status page for my life, inspired by Derek Sivers' /now movement. If you have one too, I'd love to read it."
    />

    <section class="section pt-12">
        <div class="container-page max-w-4xl">
            <div class="card flex flex-wrap items-center justify-between gap-4 p-5" data-reveal>
                <p class="flex items-center gap-3 font-semibold text-neutral-900 dark:text-neutral-100">
                    <span class="status-dot"></span>
                    All systems operational
                </p>
                <p class="font-mono text-xs text-neutral-500">last deploy: {updated}</p>
            </div>

            <!-- Uptime bar, purely decorative -->
            <div class="mt-3 flex h-8 gap-[3px]" aria-hidden="true" data-reveal>
                {Array.from({ length: 60 }).map((_, i) => (
                    <span class:list={['flex-1 rounded-sm', i === 41 ? 'bg-yellow-400' : 'bg-green-500/70']}></span>
                ))}
            </div>
            <p class="mt-2 flex justify-between font-mono text-[11px] text-neutral-500" aria-hidden="true">
                <span>60 days ago</span><span>one (1) incident: forgot to sleep</span><span>today</span>
            </p>

            <div class="mt-10 space-y-3">
                {services.map((s, i) => {
                    const st = stateStyle[s.state]
                    return (
                        <article class="card p-6 sm:p-7" data-reveal style={`--reveal-delay: ${i * 40}ms`}>
                            <header class="flex flex-wrap items-center justify-between gap-3">
                                <h2 class="flex items-center gap-3 text-xl font-bold text-neutral-900 dark:text-neutral-100">
                                    <span class="font-mono text-xs font-normal text-neutral-400">{s.name}.svc</span>
                                    {s.title}
                                </h2>
                                <span class:list={['flex items-center gap-2 font-mono text-xs', st.text]}>
                                    <span class:list={['size-2 rounded-full', st.dot]}></span>
                                    {st.label}
                                </span>
                            </header>
                            <div class="mt-4 space-y-3 leading-relaxed text-neutral-600 dark:text-neutral-400">
                                {s.items.map(item => <p>{item}</p>)}
                            </div>
                            {s.link && (
                                <a
                                    href={s.link.href}
                                    {...(s.link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                                    class="link-arrow mt-4 text-sm"
                                >
                                    {s.link.label} →
                                </a>
                            )}
                        </article>
                    )
                })}
            </div>

            <p class="mt-10 text-center text-neutral-600 dark:text-neutral-400" data-reveal>
                Want to talk about any of this? <a href={`mailto:${CONTACT.email}`} class="link-arrow">Say hello →</a>
            </p>
        </div>
    </section>
</BaseLayout>
