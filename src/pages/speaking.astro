---
import BaseLayout from '@layouts/BaseLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { CONTACT, TALKS, TALK_TYPES } from '@/data/site'
import type { TalkType } from '@/data/site'

const years = [...new Set(TALKS.map(t => t.year))].sort((a, b) => b - a)
const types = Object.keys(TALK_TYPES) as TalkType[]

const topics = [
    { title: 'Platform engineering', body: 'Golden paths, internal developer platforms, and abstracting infrastructure without hiding it.' },
    { title: 'Cloud architecture on GCP', body: 'Multi-region design, networking, reliability patterns and the trade-offs behind them.' },
    { title: 'IaC & delivery', body: 'Terraform, CI/CD and GitOps that teams can actually maintain.' },
    { title: 'Access & inclusion in tech', body: 'Building talent pipelines and communities outside the usual hubs.' },
    { title: 'Tech policy', body: 'Data protection, startup policy and digital infrastructure, from an engineer\'s seat.' },
]
---

<BaseLayout
    title="Speaking"
    description="Talks, workshops and policy panels by Amina Lawal on platform engineering, cloud architecture on Google Cloud, and inclusive tech ecosystems."
>
    <PageHeader
        path="/speaking"
        title="Talks, workshops & panels."
        lede="From DevFest stages to government policy dialogues, I speak about building infrastructure that holds up, and the ecosystems that let more people build it."
    >
        <a href={CONTACT.sessionize} target="_blank" rel="noopener noreferrer" class="btn-primary group">Sessionize profile <span class="transition group-hover:translate-x-0.5">↗</span></a>
        <a href={`mailto:${CONTACT.email}?subject=Speaking invitation`} class="btn-ghost">Invite me to speak</a>
    </PageHeader>

    <!-- Topics -->
    <section class="section pb-0 pt-14">
        <div class="container-page">
            <p class="eyebrow" data-reveal>$ cat topics.txt</p>
            <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
                {topics.map((t, i) => (
                    <div class="card p-5" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
                        <h2 class="font-bold text-neutral-900 dark:text-neutral-100">{t.title}</h2>
                        <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{t.body}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Timeline -->
    <section class="section">
        <div class="container-page" data-talks>
            <div class="flex flex-wrap items-center justify-between gap-4">
                <h2 class="font-display text-3xl font-bold text-neutral-900 dark:text-neutral-100">Appearances</h2>
                <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by format">
                    <button type="button" class="chip-filter" data-filter="all" aria-pressed="true">All <span class="font-mono text-xs opacity-60">{TALKS.length}</span></button>
                    {types.map(t => (
                        <button type="button" class="chip-filter" data-filter={t} aria-pressed="false">
                            {t === 'judge' ? 'Judging' : `${TALK_TYPES[t]}s`} <span class="font-mono text-xs opacity-60">{TALKS.filter(x => x.type === t).length}</span>
                        </button>
                    ))}
                </div>
            </div>

            <div class="mt-10 space-y-12">
                {years.map(year => (
                    <div class="grid gap-6 md:grid-cols-[6rem_1fr]" data-year>
                        <p class="font-display text-4xl font-bold text-paper-300 dark:text-ink-700 md:sticky md:top-28 md:self-start">{year}</p>
                        <ol class="relative space-y-4 border-l border-paper-300 pl-6 dark:border-ink-700">
                            {TALKS.filter(t => t.year === year).map(t => (
                                <li class="relative" data-talk data-type={t.type}>
                                    <span class="absolute -left-[1.95rem] top-7 size-3 rounded-full border-2 border-paper-100 bg-sun-400 dark:border-ink-950"></span>
                                    <article class="card p-6" data-reveal>
                                        <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-neutral-500">
                                            <span class="chip">{TALK_TYPES[t.type]}</span>
                                            <span>{t.date}</span>
                                            <span aria-hidden="true">·</span>
                                            <span>{t.location}</span>
                                        </div>
                                        <h3 class="mt-4 text-xl font-bold leading-snug text-neutral-900 dark:text-neutral-100">{t.title}</h3>
                                        <p class="mt-1 text-sm font-medium text-orange-500 dark:text-orange-300">{t.event}</p>
                                        <p class="mt-3 leading-relaxed text-neutral-600 dark:text-neutral-400">{t.description}</p>
                                        {(t.url || t.recording) && (
                                            <div class="mt-4 flex flex-wrap gap-5 text-sm">
                                                {t.url && <a href={t.url} target="_blank" rel="noopener noreferrer" class="link-arrow">Event page ↗</a>}
                                                {t.recording && <a href={t.recording} target="_blank" rel="noopener noreferrer" class="link-arrow">▶ Watch recording</a>}
                                            </div>
                                        )}
                                    </article>
                                </li>
                            ))}
                        </ol>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="section pt-0">
        <div class="container-page">
            <div class="card flex flex-col gap-6 p-8 sm:p-12 md:flex-row md:items-center md:justify-between" data-reveal>
                <div>
                    <h2 class="font-display text-3xl font-bold text-neutral-900 dark:text-neutral-100">Planning an event?</h2>
                    <p class="mt-2 max-w-xl text-neutral-600 dark:text-neutral-400">I'm open to conference talks, workshops, panels, podcasts and community events.</p>
                </div>
                <div class="flex shrink-0 flex-wrap gap-3">
                    <a href={`mailto:${CONTACT.email}?subject=Speaking invitation`} class="btn-primary">Send an invitation</a>
                    <a href={CONTACT.sessionize} target="_blank" rel="noopener noreferrer" class="btn-ghost">Sessionize ↗</a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    const root = document.querySelector<HTMLElement>('[data-talks]')!
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'))
    buttons.forEach(btn => btn.addEventListener('click', () => {
        const f = btn.dataset.filter
        buttons.forEach(b => b.setAttribute('aria-pressed', String(b === btn)))
        root.querySelectorAll<HTMLElement>('[data-talk]').forEach((t) => {
            t.hidden = f !== 'all' && t.dataset.type !== f
        })
        // Hide year groups that end up empty
        root.querySelectorAll<HTMLElement>('[data-year]').forEach((y) => {
            y.hidden = !y.querySelector('[data-talk]:not([hidden])')
        })
        // Make sure newly shown cards are visible even if they were never scrolled past
        root.querySelectorAll('[data-reveal]').forEach(el => el.classList.add('is-visible'))
    }))
</script>
