---
import { getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { ARTICLES, CONTACT } from '@/data/site'

const blogPosts = (await getCollection('posts')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const entries = [
    ...ARTICLES.map(a => ({
        title: a.title,
        description: a.description,
        url: a.url,
        external: true,
        source: a.publication,
        date: new Date(a.date),
        tags: a.tags,
    })),
    ...blogPosts.map(p => ({
        title: p.data.title,
        description: p.data.description,
        url: `/posts/${p.slug}/`,
        external: false,
        source: 'Blog',
        date: p.data.pubDate,
        tags: p.data.tags ?? [],
    })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf())

const filters = [
    { key: 'all', label: 'All', count: entries.length },
    { key: 'FreeCodeCamp', label: 'FreeCodeCamp', count: entries.filter(e => e.source === 'FreeCodeCamp').length },
    { key: 'Google Cloud', label: 'Google Cloud', count: entries.filter(e => e.source === 'Google Cloud').length },
    { key: 'Blog', label: 'Blog archive', count: entries.filter(e => e.source === 'Blog').length },
]

const sourceClass: Record<string, string> = {
    'FreeCodeCamp': '!border-green-500/40 !text-green-700 dark:!text-green-400',
    'Google Cloud': '!border-blue-500/40 !text-blue-700 dark:!text-blue-400',
    'Blog': '',
}
---

<BaseLayout
    title="Writing"
    description="Articles and tutorials by Amina Lawal on Google Cloud, Kubernetes, networking and reliability, published on FreeCodeCamp and Google Cloud's Medium publication."
>
    <PageHeader
        path="/writing"
        title="Notes from production."
        lede="Practical, tested tutorials on cloud infrastructure, networking and reliability, published on FreeCodeCamp and Google Cloud's Medium publication. Written for the engineer who has to make it work on Monday."
    >
        <a href={CONTACT.freecodecamp} target="_blank" rel="noopener noreferrer" class="btn-ghost">FreeCodeCamp author page ↗</a>
        <a href="/rss.xml" class="btn-ghost">RSS</a>
    </PageHeader>

    <section class="section pt-10">
        <div class="container-page" data-writing>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by publication">
                    {filters.filter(f => f.count > 0).map(f => (
                        <button type="button" class="chip-filter" data-filter={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>
                            {f.label} <span class="font-mono text-xs opacity-60">{f.count}</span>
                        </button>
                    ))}
                </div>
                <label class="relative block sm:w-64">
                    <span class="sr-only">Search writing</span>
                    <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 font-mono text-sm text-sun-500">grep</span>
                    <input
                        type="search"
                        data-search
                        placeholder="kubernetes, networking…"
                        class="w-full rounded-full border border-paper-300 bg-paper-50 py-2 pl-14 pr-4 text-sm outline-none transition placeholder:text-neutral-400 focus:border-sun-400 focus-visible:ring-0 focus-visible:ring-offset-0 dark:border-ink-600 dark:bg-ink-900"
                    />
                </label>
            </div>

            <ul class="mt-10 grid gap-4">
                {entries.map(e => (
                    <li
                        data-entry
                        data-source={e.source}
                        data-text={`${e.title} ${e.description} ${e.tags.join(' ')}`.toLowerCase()}
                    >
                        <a
                            href={e.url}
                            {...(e.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                            class="card card-hover group grid gap-4 p-6 sm:grid-cols-[8rem_1fr] sm:p-7"
                        >
                            <div class="flex items-center gap-3 font-mono text-xs text-neutral-500 sm:flex-col sm:items-start">
                                <span class:list={['chip', sourceClass[e.source]]}>{e.source}</span>
                                <time datetime={e.date.toISOString()}>{e.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
                            </div>
                            <div>
                                <h2 class="text-xl font-bold leading-snug text-neutral-900 transition group-hover:text-sun-600 dark:text-neutral-100 dark:group-hover:text-sun-300">
                                    {e.title}
                                </h2>
                                <p class="mt-2 leading-relaxed text-neutral-600 dark:text-neutral-400">{e.description}</p>
                                <div class="mt-4 flex flex-wrap items-center gap-1.5">
                                    {e.tags.map(t => <span class="chip">#{t}</span>)}
                                    <span class="link-arrow ms-auto text-sm">Read {e.external ? '↗' : '→'}</span>
                                </div>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>
            <p data-empty hidden class="mt-10 rounded-2xl border border-dashed border-paper-300 p-10 text-center font-mono text-sm text-neutral-500 dark:border-ink-600">
                grep: no matches. Try another word.
            </p>
        </div>
    </section>
</BaseLayout>

<script>
    const root = document.querySelector<HTMLElement>('[data-writing]')!
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'))
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-entry]'))
    const search = root.querySelector<HTMLInputElement>('[data-search]')!
    const empty = root.querySelector<HTMLElement>('[data-empty]')!
    let filter = 'all'

    function apply() {
        const words = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean)
        let shown = 0
        for (const item of items) {
            const match = (filter === 'all' || item.dataset.source === filter)
                && words.every(w => item.dataset.text!.includes(w))
            item.hidden = !match
            if (match)
                shown++
        }
        empty.hidden = shown > 0
    }

    buttons.forEach(btn => btn.addEventListener('click', () => {
        filter = btn.dataset.filter!
        buttons.forEach(b => b.setAttribute('aria-pressed', String(b === btn)))
        apply()
    }))
    search.addEventListener('input', apply)
</script>
