---
import { getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import Terminal from '@components/Terminal.astro'
import ProjectCard from '@components/projects/ProjectCard.astro'
import Image from '@components/ui/images/Image.astro'
import illustration from '@images/test3.png'
import headshot from '@images/amina-headshot.jpg'
import { ARTICLES, CONTACT, IMPACT, MENTORSHIP, STACK, TALKS, TALK_TYPES } from '@/data/site'

const projects = (await getCollection('projects'))
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)).slice(0, 3)
const latestArticles = ARTICLES.slice(0, 4)
const recentTalks = TALKS.filter((t, i, all) => all.findIndex(o => o.title === t.title) === i).slice(0, 3)

const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })
// Short pseudo commit hash so the writing list reads like `git log`
const hash = (s: string) => [...s].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7).toString(16).slice(0, 7)

const doors = [
    {
        n: '01',
        title: 'Engineer',
        body: 'Kubernetes, Terraform and Google Cloud. I build internal platforms and golden paths so teams ship without fighting their infrastructure.',
        href: '/projects',
        cta: 'See projects',
    },
    {
        n: '02',
        title: 'Writer',
        body: 'Practical, tested tutorials on FreeCodeCamp and Google Cloud\'s Medium publication, plus the broken bits nobody else mentions.',
        href: '/writing',
        cta: 'Read articles',
    },
    {
        n: '03',
        title: 'Speaker',
        body: 'DevFest stages, community meetups and government policy dialogues on cloud, platform engineering and access.',
        href: '/speaking',
        cta: 'View talks',
    },
    {
        n: '04',
        title: 'Builder of people',
        body: 'Founder of G3Women, co-founder of CNCF Kaduna, WTM Ambassador, and now a mentor teaching cloud from first principles.',
        href: '/community',
        cta: 'Meet the communities',
    },
]
---

<BaseLayout
    title="Amina Lawal | Platform Engineer, Writer & Community Builder"
    description="Amina Lawal is a Platform Engineer and Google Cloud Professional Cloud Architect. Founder of G3Women, mentor, speaker, and writer for FreeCodeCamp and Google Cloud."
>
    <!-- Hero -->
    <section class="bg-grid relative overflow-hidden">
        <div class="pointer-events-none absolute -left-32 top-10 size-96 rounded-full bg-sun-400/20 blur-3xl"></div>
        <div class="pointer-events-none absolute -right-20 bottom-0 size-80 rounded-full bg-yellow-400/20 blur-3xl"></div>
        <div class="container-page relative grid items-center gap-12 pb-20 pt-14 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:pb-28">
            <div>
                <p class="eyebrow" data-reveal>
                    <span class="status-dot"></span>
                    Mentorship waitlist open · Cohort 2
                </p>
                <h1 class="mt-5 font-display text-5xl font-bold leading-[1.02] text-neutral-900 dark:text-neutral-50 sm:text-6xl lg:text-7xl" data-reveal style="--reveal-delay: 80ms">
                    Hello, I'm Amina.
                    <span class="mt-2 block text-[0.62em] leading-tight text-neutral-500 dark:text-neutral-400">
                        I build <span class="mark text-neutral-800 dark:text-neutral-100" data-rotator data-words='["platforms.","golden paths.","communities.","engineers."]'>platforms.</span><span class="caret text-sun-500 dark:text-sun-300">_</span>
                    </span>
                </h1>
                <p class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-neutral-600 dark:text-neutral-400" data-reveal style="--reveal-delay: 160ms">
                    I'm a Platform Engineer and Google Cloud Professional Cloud Architect.
                </p>
                <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 240ms">
                    <a href="/mentorship" class="btn-primary group">
                        Learn cloud with me
                        <span class="transition group-hover:translate-x-0.5">→</span>
                    </a>
                    <a href="/writing" class="btn-ghost">Read my writing</a>
                </div>
                <p class="mt-6 hidden font-mono text-xs text-neutral-500 sm:block" data-reveal style="--reveal-delay: 320ms">
                    Tip: press <kbd class="kbd">/</kbd> anywhere to jump around the site.
                </p>
            </div>
            <div class="relative" data-reveal style="--reveal-delay: 200ms">
                <figure class="relative ms-auto w-[70%] max-w-[22rem] overflow-hidden rounded-[2rem] border-4 border-paper-50 shadow-[0_30px_60px_-30px_rgb(0_0_0_/_0.45)] rotate-[2deg] transition duration-500 hover:rotate-0 dark:border-ink-800">
                    <Image src={headshot} alt="Amina Lawal, portrait" width={720} height={900} format="webp" loading="eager" class="aspect-[4/5] w-full object-cover object-top grayscale" />
                </figure>
                <div class="relative -mt-20 w-[92%] sm:-mt-28 lg:-ms-6 lg:-mt-36">
                    <Terminal />
                </div>
            </div>
        </div>
    </section>

    <!-- Stack marquee -->
    <section class="border-y border-paper-200 bg-paper-50 py-5 dark:border-ink-800 dark:bg-ink-900/50" aria-label="Tools I work with">
        <div class="marquee overflow-hidden">
            <div class="marquee-track flex w-max gap-10 font-mono text-sm text-neutral-500">
                {[...STACK, ...STACK].map((tool, i) => (
                    <span class="flex items-center gap-10 whitespace-nowrap" aria-hidden={i >= STACK.length ? 'true' : undefined}>
                        {tool}<span class="text-sun-500">◆</span>
                    </span>
                ))}
            </div>
        </div>
    </section>

    <!-- Four doors -->
    <section class="section">
        <div class="container-page">
            <div class="grid gap-6 lg:grid-cols-[1fr_1.6fr] lg:gap-12">
                <div data-reveal>
                    <p class="eyebrow">$ ls ~/amina</p>
                    <h2 class="h-section">One person, four ways in.</h2>
                    <p class="lede">This isn't only a tech blog. Pick whichever door you came for. They all lead to the same belief: good infrastructure, and good communities, make everyone around them better.</p>
                    <div class="relative mt-8 hidden overflow-hidden rounded-3xl bg-ink-950 lg:block">
                        <Image src={illustration} alt="Illustration of Amina coding on a laptop, surrounded by the Google Cloud, Kubernetes and Terraform logos" class="w-full" width={560} height={560} format="webp" />
                    </div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    {doors.map((door, i) => (
                        <a href={door.href} class="card card-hover group flex flex-col p-6 sm:p-7" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
                            <span class="font-mono text-xs text-neutral-400">{door.n}</span>
                            <h3 class="mt-6 text-2xl font-bold text-neutral-900 transition group-hover:text-sun-600 dark:text-neutral-100 dark:group-hover:text-sun-300">{door.title}</h3>
                            <p class="mt-3 flex-grow text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{door.body}</p>
                            <span class="link-arrow mt-6 text-sm">{door.cta} <span aria-hidden="true">→</span></span>
                        </a>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- Mentorship spotlight -->
    <section class="section pt-0">
        <div class="container-page">
            <div class="relative overflow-hidden rounded-[2rem] bg-ink-950 p-7 text-neutral-200 sm:p-12" data-reveal>
                <div class="bg-grid pointer-events-none absolute inset-0 opacity-60"></div>
                <div class="pointer-events-none absolute -right-20 -top-24 size-96 rounded-full bg-sun-400/25 blur-3xl"></div>
                <div class="relative grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:items-center">
                    <div>
                        <p class="eyebrow text-sun-300">New · {MENTORSHIP.name}</p>
                        <h2 class="mt-3 text-balance font-display text-3xl font-bold text-white sm:text-5xl">
                            4 months. Real cloud. <span class="text-sun-300">Proceeds fund G3Women.</span>
                        </h2>
                        <p class="mt-5 max-w-lg text-pretty leading-relaxed text-neutral-400">
                            A small-cohort, live mentorship, two weeks per module, that takes you from Linux and networking to Kubernetes, IaC, CI/CD and observability on Google Cloud. No toy sandboxes: you will break real things on purpose and learn how they recover. Proceeds go to G3Women's programmes for women in tech.
                        </p>
                        <div class="mt-8 flex flex-wrap gap-3">
                            <a href="/mentorship" class="btn-primary group">How it works <span class="transition group-hover:translate-x-0.5">→</span></a>
                            <a href={MENTORSHIP.waitlist} target="_blank" rel="noopener noreferrer" class="btn border border-ink-600 text-neutral-200 hover:border-neutral-300">Join the waitlist</a>
                        </div>
                    </div>

                    <!-- Pipeline: the 8 modules as CI stages -->
                    <ol class="grid gap-2 font-mono text-sm sm:grid-cols-2" aria-label="Curriculum, module by module">
                        {MENTORSHIP.modules.map(w => (
                            <li class="group flex items-center gap-3 rounded-xl border border-ink-700 bg-ink-900/80 px-4 py-3 transition hover:border-sun-400/60">
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full border border-green-500/50 text-[10px] text-green-400 transition group-hover:bg-green-500 group-hover:text-ink-950">✓</span>
                                <span class="min-w-0">
                                    <span class="block text-[10px] uppercase tracking-wider text-neutral-500">module {w.n} · wk {w.weeks}</span>
                                    <span class="block leading-snug text-neutral-200">{w.title}</span>
                                </span>
                            </li>
                        ))}
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <!-- Latest writing as git log -->
    <section class="section pt-0">
        <div class="container-page">
            <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
                <div>
                    <p class="eyebrow">$ git log --writing</p>
                    <h2 class="h-section">Latest writing</h2>
                </div>
                <a href="/writing" class="link-arrow">All writing <span aria-hidden="true">→</span></a>
            </div>
            <ul class="mt-10 divide-y divide-paper-200 border-y border-paper-200 dark:divide-ink-800 dark:border-ink-800">
                {latestArticles.map((a, i) => (
                    <li data-reveal style={`--reveal-delay: ${i * 60}ms`}>
                        <a href={a.url} target="_blank" rel="noopener noreferrer" class="group grid gap-2 py-6 sm:grid-cols-[7rem_1fr_auto] sm:items-baseline sm:gap-6">
                            <span class="font-mono text-xs text-orange-500 dark:text-orange-300">{hash(a.url)}</span>
                            <span>
                                <span class="block text-lg font-semibold leading-snug text-neutral-900 transition group-hover:text-sun-600 dark:text-neutral-100 dark:group-hover:text-sun-300">{a.title}</span>
                                <span class="mt-1.5 block text-sm text-neutral-600 dark:text-neutral-400">{a.description}</span>
                            </span>
                            <span class="flex items-center gap-3 font-mono text-xs text-neutral-500 sm:flex-col sm:items-end">
                                <span class:list={['chip', a.publication === 'FreeCodeCamp' ? '!border-green-500/40 !text-green-700 dark:!text-green-400' : '!border-blue-500/40 !text-blue-700 dark:!text-blue-400']}>{a.publication}</span>
                                {fmt(a.date)}
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- Impact -->
    <section class="section pt-0">
        <div class="container-page">
            <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-12">
                <div data-reveal>
                    <p class="eyebrow">$ uptime --community</p>
                    <h2 class="h-section">Beyond the terminal</h2>
                    <p class="lede">
                        I founded <a href={CONTACT.g3women} target="_blank" rel="noopener noreferrer" class="font-semibold text-neutral-900 underline decoration-sun-400 decoration-2 underline-offset-4 dark:text-neutral-100">G3Women</a> to close structural gaps for women in digital tech across northern Nigeria. I also shape policy conversations and run programmes that produce engineers, not certificates.
                    </p>
                    <a href="/community" class="link-arrow mt-6">Community & impact <span aria-hidden="true">→</span></a>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    {IMPACT.map((s, i) => (
                        <div class="card p-6" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
                            <span class:list={['block h-1.5 w-10 rounded-full', i % 2 ? 'bg-orange-300' : 'bg-sun-400']}></span>
                            <p class="mt-4 font-display text-5xl font-bold text-neutral-900 dark:text-neutral-50" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</p>
                            <p class="mt-3 font-semibold text-neutral-900 dark:text-neutral-100">{s.label}</p>
                            <p class="mt-1 font-mono text-xs text-neutral-500">{s.note}</p>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- Speaking -->
    <section class="section pt-0">
        <div class="container-page">
            <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
                <div>
                    <p class="eyebrow">$ cat talks.log</p>
                    <h2 class="h-section">On stage lately</h2>
                </div>
                <a href="/speaking" class="link-arrow">All talks <span aria-hidden="true">→</span></a>
            </div>
            <div class="mt-10 grid gap-4 md:grid-cols-3">
                {recentTalks.map((t, i) => (
                    <article class="card flex flex-col p-6" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
                        <div class="flex items-center justify-between font-mono text-xs text-neutral-500">
                            <span class="chip">{TALK_TYPES[t.type]}</span>
                            {t.date}
                        </div>
                        <h3 class="mt-5 text-lg font-bold leading-snug text-neutral-900 dark:text-neutral-100">{t.title}</h3>
                        <p class="mt-2 text-sm font-medium text-orange-500 dark:text-orange-300">{t.event}</p>
                        <p class="mt-3 flex-grow text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{t.description}</p>
                        {t.recording && <a href={t.recording} target="_blank" rel="noopener noreferrer" class="link-arrow mt-5 text-sm">Watch recording →</a>}
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- Projects -->
    <section class="section pt-0">
        <div class="container-page">
            <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
                <div>
                    <p class="eyebrow">$ kubectl get projects</p>
                    <h2 class="h-section">Things I've built</h2>
                </div>
                <a href="/projects" class="link-arrow">All projects <span aria-hidden="true">→</span></a>
            </div>
            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {projects.map((project, i) => (
                    <div data-reveal style={`--reveal-delay: ${i * 70}ms`}><ProjectCard project={project} /></div>
                ))}
            </div>
        </div>
    </section>

    <!-- Elsewhere -->
    <section class="section pt-0">
        <div class="container-page">
            <div class="grid gap-4 md:grid-cols-[1.4fr_1fr]">
                <div class="card overflow-hidden" data-reveal>
                    <div class="aspect-video">
                        <iframe
                            class="h-full w-full"
                            src="https://www.youtube-nocookie.com/embed/x-iHbFicvH4"
                            title="Amina Lawal on YouTube: containers and running your first Docker container"
                            loading="lazy"
                            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                        ></iframe>
                    </div>
                </div>
                <div class="card flex flex-col p-7" data-reveal style="--reveal-delay: 80ms">
                    <p class="eyebrow">$ open --elsewhere</p>
                    <h2 class="mt-3 text-2xl font-bold text-neutral-900 dark:text-neutral-100">Watch, follow, fork.</h2>
                    <p class="mt-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">Video walkthroughs from containers to clusters, experiments on GitHub, and shorter thoughts on X and LinkedIn.</p>
                    <ul class="mt-6 grid flex-grow content-end gap-2 font-mono text-sm">
                        {[
                            ['YouTube', CONTACT.youtube, '@aminalawal3999'],
                            ['GitHub', CONTACT.github, '@Amiynarh'],
                            ['LinkedIn', CONTACT.linkedin, 'aminalawalofficial'],
                            ['X', CONTACT.x, '@amiynarh'],
                        ].map(([name, url, handle]) => (
                            <li>
                                <a href={url} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between rounded-xl border border-paper-200 px-4 py-2.5 transition hover:border-sun-400 dark:border-ink-700">
                                    <span class="text-neutral-800 dark:text-neutral-200">{name}</span>
                                    <span class="text-xs text-neutral-500 transition group-hover:text-sun-600">{handle} ↗</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    // Rotate the word after "I build …" with a small typing effect
    const el = document.querySelector<HTMLElement>('[data-rotator]')
    if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const words: string[] = JSON.parse(el.dataset.words ?? '[]')
        let w = 0
        const sleep = (ms: number) => new Promise(r => setTimeout(r, ms))
        const loop = async () => {
            for (;;) {
                await sleep(2200)
                const current = words[w]
                for (let i = current.length; i >= 0; i--) {
                    el.textContent = current.slice(0, i)
                    await sleep(35)
                }
                w = (w + 1) % words.length
                const next = words[w]
                for (let i = 1; i <= next.length; i++) {
                    el.textContent = next.slice(0, i)
                    await sleep(70)
                }
            }
        }
        loop()
    }
</script>
