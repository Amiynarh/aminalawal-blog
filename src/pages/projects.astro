---
import { getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import ProjectCard from '@components/projects/ProjectCard.astro'
import { CONTACT, RECOGNITION } from '@/data/site'

const projects = (await getCollection('projects'))
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))

const skillGroups = [
    { label: 'Cloud', skills: ['Google Cloud', 'GKE', 'Cloud Run', 'Cloud Build', 'AWS'] },
    { label: 'Platform', skills: ['Kubernetes', 'Docker', 'Helm', 'GitOps', 'Terraform'] },
    { label: 'Delivery', skills: ['GitHub Actions', 'Cloud Build', 'CI/CD design'] },
    { label: 'Observability', skills: ['Prometheus', 'Grafana', 'ELK Stack'] },
    { label: 'Languages', skills: ['Python', 'Bash'] },
    { label: 'Frameworks', skills: ['FastAPI', 'Django', 'Next.js'] },
]
---

<BaseLayout
    title="Projects"
    description="Projects by Amina Lawal across platform engineering, cloud infrastructure and developer tooling, including the G3Digital Academy on Google Cloud Run."
>
    <PageHeader
        path="/projects"
        title="Things I've built."
        lede="Platforms, tools and experiments, from a multilingual learning platform on Cloud Run to templates that give solo developers a production-grade pipeline."
    >
        <a href={CONTACT.github} target="_blank" rel="noopener noreferrer" class="btn-ghost">More on GitHub ↗</a>
    </PageHeader>

    <section class="section pt-14">
        <div class="container-page">
            <!-- Featured: G3Digital Academy -->
            <a href="https://academy.g3women.org/" target="_blank" rel="noopener noreferrer" class="group relative block overflow-hidden rounded-[2rem] bg-ink-950 p-8 text-neutral-300 sm:p-12" data-reveal>
                <div class="bg-grid pointer-events-none absolute inset-0 opacity-60"></div>
                <div class="pointer-events-none absolute -bottom-24 -right-16 size-96 rounded-full bg-sun-400/25 blur-3xl"></div>
                <div class="relative grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
                    <div>
                        <p class="eyebrow text-sun-300">Featured · G3Women</p>
                        <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-5xl">G3Digital Academy</h2>
                        <p class="mt-4 max-w-xl leading-relaxed text-neutral-400">
                            A serverless learning platform I architected and built as G3Women's CTO. It runs on Google Cloud Run with CI/CD through Cloud Build, and teaches natively in English, Hausa, Yoruba and Igbo. Each language is a first-class part of the data model, not a translation layer.
                        </p>
                        <span class="link-arrow mt-6 text-sun-300">academy.g3women.org ↗</span>
                    </div>
                    <ul class="grid grid-cols-2 gap-2 font-mono text-xs">
                        {['Cloud Run', 'Cloud Build', 'Serverless', '4 languages', 'CI/CD', 'Learning companion'].map(t => (
                            <li class="rounded-lg border border-ink-700 bg-ink-900/80 px-3 py-2 text-neutral-300">{t}</li>
                        ))}
                    </ul>
                </div>
            </a>

            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {projects.map((project, i) => (
                    <div data-reveal style={`--reveal-delay: ${i * 70}ms`}><ProjectCard project={project} /></div>
                ))}
            </div>
        </div>
    </section>

    <section class="section pt-0">
        <div class="container-page grid gap-10 lg:grid-cols-[1fr_2fr]">
            <div data-reveal>
                <p class="eyebrow">$ cat stack.yaml</p>
                <h2 class="h-section">Tools I reach for</h2>
                <ul class="mt-8 space-y-3">
                    {RECOGNITION.map(r => (
                        <li class="flex gap-3">
                            <span class="mt-1 text-sun-500">✦</span>
                            <span>
                                <span class="block font-semibold text-neutral-900 dark:text-neutral-100">{r.title}</span>
                                <span class="text-sm text-neutral-500">{r.by}</span>
                            </span>
                        </li>
                    ))}
                </ul>
            </div>
            <div class="terminal p-6 sm:p-8" data-reveal style="--reveal-delay: 80ms">
                {skillGroups.map(g => (
                    <div class="grid gap-2 border-b border-ink-700 py-4 first:pt-0 last:border-0 last:pb-0 sm:grid-cols-[9rem_1fr]">
                        <span class="text-sun-300">{g.label.toLowerCase()}:</span>
                        <span class="flex flex-wrap gap-2">
                            {g.skills.map(s => <span class="rounded-md border border-ink-600 px-2 py-0.5 text-neutral-300">{s}</span>)}
                        </span>
                    </div>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>
