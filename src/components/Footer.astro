---
import { FooterLinks, SITE } from '@/config'
import { CONTACT } from '@/data/site'

const year = new Date().getFullYear()
---

<footer class="mt-16 border-t border-paper-200 bg-paper-50 dark:border-ink-800 dark:bg-ink-900/60">
    <div class="container-page py-16">
        <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr]">
            <div>
                <p class="eyebrow">$ ./say-hello.sh</p>
                <h2 class="mt-4 text-balance font-display text-4xl font-bold text-neutral-900 dark:text-neutral-100 sm:text-5xl">
                    Let's build something <span class="mark">that lasts.</span>
                </h2>
                <p class="mt-4 max-w-md text-neutral-600 dark:text-neutral-400">
                    Platform work, a talk, a community programme, or a mentee who wants to break things on purpose. My inbox is open.
                </p>
                <div class="mt-7 flex flex-wrap gap-3">
                    <a href={`mailto:${CONTACT.email}`} class="btn-primary">
                        Email me
                        <span class="transition group-hover:translate-x-0.5">→</span>
                    </a>
                    <a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost">Connect on LinkedIn</a>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
                {FooterLinks.map(section => (
                    <div>
                        <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-500">{section.section}</h3>
                        <ul class="mt-4 space-y-2.5">
                            {section.links.map(link => (
                                <li>
                                    <a
                                        href={link.url}
                                        {...(link.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                                        class="text-sm text-neutral-700 transition hover:text-sun-600 dark:text-neutral-300 dark:hover:text-sun-300"
                                    >
                                        {link.name}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>

        <div class="mt-14 flex flex-col gap-3 border-t border-paper-200 pt-6 font-mono text-xs text-neutral-500 dark:border-ink-800 sm:flex-row sm:items-center sm:justify-between">
            <p class="flex items-center gap-2">
                <span class="status-dot"></span>
                All systems operational · Platform engineer, writer, founder
            </p>
            <p>
                © {year} {SITE.author} · Built with Astro · Press <kbd class="kbd">/</kbd> to search
            </p>
        </div>
    </div>
</footer>
