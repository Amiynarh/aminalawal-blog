---
interface Props {
    path: string
    title: string
    lede?: string
}

const { path, title, lede } = Astro.props
---

<section class="bg-grid relative overflow-hidden border-b border-paper-200 dark:border-ink-800">
    <div class="pointer-events-none absolute -right-24 -top-24 size-80 rounded-full bg-sun-400/15 blur-3xl"></div>
    <div class="container-page relative pb-14 pt-16 sm:pb-20 sm:pt-24">
        <p class="eyebrow" data-reveal>
            <span class="text-neutral-400 dark:text-neutral-600">~</span>{path}
        </p>
        <h1 class="mt-4 max-w-3xl text-balance font-display text-4xl font-bold text-neutral-900 dark:text-neutral-100 sm:text-6xl" data-reveal style="--reveal-delay: 80ms">
            <Fragment set:html={title} />
        </h1>
        {lede && <p class="lede" data-reveal style="--reveal-delay: 160ms">{lede}</p>}
        <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 240ms">
            <slot />
        </div>
    </div>
</section>
