---
import type { CollectionEntry } from 'astro:content'
import Image from '@components/ui/images/Image.astro'

const { project } = Astro.props

interface Props {
    project: CollectionEntry<'projects'>
}

const comingSoon = /coming soon/i.test(project.data.title)
const title = project.data.title.replace(/\s*\(coming soon\)/i, '')
---

<a
    class="card card-hover group flex h-full flex-col overflow-hidden"
    href={project.data.url}
    target="_blank"
    rel="noopener noreferrer"
    data-astro-prefetch="false"
>
    <div class="relative aspect-[16/10] overflow-hidden bg-paper-200 dark:bg-ink-800">
        <Image
            class="size-full object-cover transition duration-700 group-hover:scale-105"
            src={project.data.banner}
            alt=""
            draggable="false"
            loading="lazy"
            format="avif"
            width="800"
            height="500"
        />
        {comingSoon && <span class="absolute right-3 top-3 rounded-full bg-sun-400 px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-neutral-900">In progress</span>}
    </div>
    <div class="flex flex-grow flex-col p-6">
        <h3 class="flex items-start justify-between gap-3 text-xl font-bold text-neutral-900 transition group-hover:text-sun-600 dark:text-neutral-100 dark:group-hover:text-sun-300">
            {title}
            <span class="text-base text-neutral-400 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-sun-500" aria-hidden="true">↗</span>
        </h3>
        <p class="mt-2 flex-grow text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
            {project.data.description}
        </p>
        <div class="mt-5 flex flex-wrap gap-1.5">
            {project.data.tech.map((tech: string) => <span class="chip">{tech}</span>)}
        </div>
    </div>
</a>
